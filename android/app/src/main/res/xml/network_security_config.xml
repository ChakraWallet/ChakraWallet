<?xml version="1.0" encoding="utf-8"?>
<!-- Plain-HTTP sites can be opened in the in-app browser (the app marks them as not secure).
     Certificates: only the system authorities are trusted (no user-installed CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
