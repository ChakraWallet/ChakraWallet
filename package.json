    "@capacitor/cli": "^7.6.10",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@openzeppelin/contracts": "5.6.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "solc": "^0.8.38"
