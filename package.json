{
  "name": "chakra",
  "version": "1.0.0",
  "private": true,
  "description": "Chakra - a simple Ethereum wallet, MetaMask compatible, for Chrome, Firefox and Android",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "android": "node scripts/android.mjs",
    "build:ext": "node build.mjs --ext",
    "test": "node scripts/run-tests.mjs && node scripts/i18n-check.mjs",
    "test:unit": "node scripts/run-tests.mjs",
    "i18n-check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
