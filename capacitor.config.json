{
  "appId": "dev.chakrawallet",
  "appName": "Chakra",
  "webDir": "dist/android-web",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "disable"
    }
  }
}
